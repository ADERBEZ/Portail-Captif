<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title data-i18n="page_title">LaSalle — Portail Numérique Actif</title>
  <style>
      @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500;600&display=swap');

      :root {
        --clr-bg:         #f4f6fb;
        --clr-surface:    #ffffff;
        --clr-primary:    #1A70A7;
        --clr-rose:       #E1347E;
        --clr-yellow:     #F7B825;
        --clr-green:      #93C150;
        --clr-text:       #1c1f26;
        --clr-muted:      #6b7280;
        --clr-border:     #dde3ed;
        --clr-input-bg:   #f5f7fb;
        --radius:         10px;
        --shadow-card:    0 8px 40px rgba(26,112,167,0.13), 0 1.5px 6px rgba(0,0,0,0.06);
        --transition:     0.22s cubic-bezier(.4,0,.2,1);
        --font-display:   'Playfair Display', Georgia, serif;
        --font-body:      'DM Sans', 'Segoe UI', sans-serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 16px; scroll-behavior: smooth; }

      body {
        font-family: var(--font-body);
        background: var(--clr-bg);
        color: var(--clr-text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        position: relative;
        overflow-x: hidden;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background:
          linear-gradient(135deg, rgba(26,112,167,0.06) 0%, transparent 50%),
          linear-gradient(225deg, rgba(225,52,126,0.04) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
      }

      body::after {
        content: '';
        position: fixed;
        top: -120px; right: -120px;
        width: 420px; height: 420px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(147,193,80,0.07) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      .page-wrapper {
        position: relative;
        z-index: 1;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 32px 16px 24px;
      }

      /* ── Top bar ── */
      .topbar {
        width: 100%;
        max-width: 460px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-bottom: 12px;
      }

      .lang-selector {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: 8px;
        padding: 6px 10px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
      }
      .lang-selector svg { color: var(--clr-primary); flex-shrink: 0; }
      .lang-selector select {
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--clr-primary);
        background: transparent;
        border: none;
        outline: none;
        cursor: pointer;
        padding-right: 4px;
        appearance: none;
        -webkit-appearance: none;
      }
      .lang-selector-arrow { color: var(--clr-muted); font-size: 0.65rem; pointer-events: none; }

      /* ── Card ── */
      .card {
        width: 100%;
        max-width: 460px;
        background: var(--clr-surface);
        border-radius: 18px;
        box-shadow: var(--shadow-card);
        border: 1px solid rgba(212,217,226,0.7);
        overflow: hidden;
        animation: slideUp 0.55s cubic-bezier(.22,1,.36,1) both;
      }

      @keyframes slideUp {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* ── Header ── */
      .card-header {
        background: linear-gradient(135deg, #1A70A7 0%, #105686 40%, #0d4a75 100%);
        padding: 36px 40px 28px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        position: relative;
        overflow: hidden;
      }
      .card-header::before {
        content: '';
        position: absolute;
        bottom: -50px; right: -50px;
        width: 200px; height: 200px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(225,52,126,0.35) 0%, transparent 70%);
        pointer-events: none;
      }
      .card-header::after {
        content: '';
        position: absolute;
        top: -40px; left: -40px;
        width: 160px; height: 160px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(247,184,37,0.30) 0%, transparent 70%);
        pointer-events: none;
      }

      .logo-wrap { position: relative; z-index: 1; }
      .logo-circle {
        width: 92px; height: 92px;
        border-radius: 50%;
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow:
          0 4px 24px rgba(0,0,0,0.22),
          0 0 0 3px #ffffff,
          0 0 0 6px #E1347E,
          0 0 0 8px #F7B825,
          0 0 0 10px #93C150,
          0 0 0 12px #1A70A7;
        overflow: hidden;
      }
      .logo-circle img {
        width: 84px; height: 84px;
        object-fit: contain;
        border-radius: 50%;
      }

      .school-name { position: relative; z-index: 1; text-align: center; }
      .school-name p {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.90);
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      /* ── Accent bar ── */
      .accent-bar {
        width: 100%;
        height: 5px;
        background: linear-gradient(90deg, #E1347E 0%, #F7B825 33%, #93C150 66%, #1A70A7 100%);
        background-size: 250%;
        animation: shimmer 5s linear infinite;
      }
      @keyframes shimmer {
        0%   { background-position: 0% 50%; }
        100% { background-position: 250% 50%; }
      }

      /* ── Card body ── */
      .card-body { padding: 40px 40px 36px; text-align: center; }

      /* ── Icône connecté ── */
      .status-icon {
        width: 72px; height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(147,193,80,0.15) 0%, rgba(147,193,80,0.08) 100%);
        border: 2.5px solid rgba(147,193,80,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        animation: popIn 0.5s cubic-bezier(.22,1,.36,1) 0.3s both;
      }
      @keyframes popIn {
        from { opacity: 0; transform: scale(0.6); }
        to   { opacity: 1; transform: scale(1); }
      }
      .status-icon svg { color: var(--clr-green); }

      /* Dot animé */
      .status-dot-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-bottom: 8px;
      }
      .status-dot {
        width: 9px; height: 9px;
        border-radius: 50%;
        background: var(--clr-green);
        box-shadow: 0 0 0 0 rgba(147,193,80,0.6);
        animation: pulse-dot 2s infinite;
      }
      @keyframes pulse-dot {
        0%   { box-shadow: 0 0 0 0 rgba(147,193,80,0.6); }
        70%  { box-shadow: 0 0 0 8px rgba(147,193,80,0); }
        100% { box-shadow: 0 0 0 0 rgba(147,193,80,0); }
      }
      .status-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--clr-green);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .card-body h2 {
        font-family: var(--font-display);
        font-size: 1.25rem;
        color: var(--clr-text);
        margin-bottom: 10px;
        font-weight: 600;
      }

      .card-body p.subtitle {
        font-size: 0.88rem;
        color: var(--clr-muted);
        line-height: 1.6;
        margin-bottom: 28px;
      }

      /* ── Info box ── */
      .info-box {
        background: var(--clr-input-bg);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius);
        padding: 14px 18px;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        gap: 12px;
        text-align: left;
      }
      .info-box svg { color: var(--clr-primary); flex-shrink: 0; }
      .info-box-text { font-size: 0.84rem; color: var(--clr-muted); line-height: 1.5; }
      .info-box-text strong { color: var(--clr-text); font-size: 0.90rem; display: block; margin-bottom: 2px; }

      /* ── Bouton déconnexion ── */
      .btn-logout {
        width: 100%;
        padding: 13px;
        background: linear-gradient(135deg, #E1347E 0%, #c0254a 100%);
        color: #fff;
        border: none;
        border-radius: var(--radius);
        font-family: var(--font-body);
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        position: relative;
        overflow: hidden;
        transition: box-shadow var(--transition), transform var(--transition), background var(--transition);
        text-shadow: 0 1px 3px rgba(0,0,0,0.18);
      }
      .btn-logout::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 55%);
        pointer-events: none;
      }
      .btn-logout:hover {
        background: linear-gradient(135deg, #c0254a 0%, #a01e3d 100%);
        box-shadow: 0 6px 24px rgba(225,52,126,0.40);
        transform: translateY(-2px);
      }
      .btn-logout:active { transform: translateY(0); box-shadow: none; }

      /* ── Footer ── */
      footer {
        margin-top: 24px;
        font-size: 0.75rem;
        color: var(--clr-muted);
        text-align: center;
        line-height: 1.7;
      }
      footer a { color: var(--clr-primary); text-decoration: none; font-weight: 500; opacity: 0.8; }
      footer a:hover { opacity: 1; text-decoration: underline; }

      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: var(--clr-bg); }
      ::-webkit-scrollbar-thumb { background: var(--clr-border); border-radius: 4px; }

      @media (max-width: 520px) {
        .card-header { padding: 28px 24px 22px; }
        .card-body   { padding: 32px 24px 28px; }
        .card { border-radius: 14px; }
      }
  </style>
</head>
