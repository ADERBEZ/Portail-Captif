let currentLang = 'fr';

function setLang(lang) {
  const t = translations[lang] || translations['fr'];
  currentLang = lang;
  document.documentElement.dir = (lang === 'ar') ? 'rtl' : 'ltr';
  document.documentElement.lang = lang;
  document.title = t.page_title;

  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.getAttribute('data-i18n');
    if (t[key] !== undefined) {
      if (key === 'connected_msg') {
        el.innerHTML = t[key];
      } else {
        el.textContent = t[key];
      }
    }
  });
}

function handleLogout(form) {
  const t = translations[currentLang] || translations['fr'];
  const btn = document.getElementById('btn-logout');
  const txt = document.getElementById('btn-logout-text');
  if (btn) {
    btn.disabled = true;
    btn.style.opacity = '0.7';
    btn.style.cursor = 'not-allowed';
  }
  if (txt) txt.textContent = t.btn_loading;

  // pfSense gère la redirection après déconnexion.
  // Fallback JS : si pfSense ne redirige pas dans les 3s, on force le retour vers le portail.
  setTimeout(function() {
    window.location.replace('$PORTAL_ACTION$');
  }, 3000);

  return true; // laisse le formulaire être soumis à pfSense
}

setLang('fr');
